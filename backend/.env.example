PORT=5000
JWT_SECRET=your_jwt_secret_here

# Supabase (service role key — used for Auth admin calls and DB access)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Pseudonymous holder ID salt (hybrid signing model, Section 1)
# holderId = keccak256(abi.encodePacked(authUserId, HOLDER_ID_SALT))
# Generate a long random value and never commit it or change it after
# policyholders have registered (their holderId would no longer match).
HOLDER_ID_SALT=change_me_to_a_long_random_secret

# Blockchain
RPC_URL=http://127.0.0.1:8545
# Backend relayer wallet — signs every policy/claim transaction on behalf
# of policyholders (they have no wallet in this model). Keep secret.
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_WALLET_PRIVATE_KEY
POLICY_REGISTRY_ADDRESS=0xDEPLOYED_POLICY_REGISTRY_ADDRESS
CLAIM_REGISTRY_ADDRESS=0xDEPLOYED_CLAIM_REGISTRY_ADDRESS
